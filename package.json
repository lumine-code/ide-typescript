{
  "name": "ide-typescript",
  "author": "lumine-code",
  "description": "TypeScript and JavaScript language-server adapter.",
  "repository": "https://github.com/lumine-code/ide-typescript",
  "bugs": {
    "url": "https://github.com/lumine-code/ide-typescript/issues"
  },
  "keywords": [
    "language-server",
    "lsp",
    "tsserver",
    "intellisense",
    "javascript",
    "jsx",
    "tsx"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../ide-typescript/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "lumine.languageServer": {
      "versions": {
        "^1.0.0": "consumeLanguageServer"
      }
    }
  },
  "dependencies": {
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "serverPath": {
      "title": "Server Path",
      "description": "Absolute path to a `typescript-language-server` executable. Leave empty to use the bundled server.",
      "type": "string",
      "default": ""
    }
  }
}
